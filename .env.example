# Telegram bot token from @BotFather
BOT_TOKEN=1234567890:REPLACE_ME

# Public channel: @your_channel_username
# Private channel: numeric ID such as -1001234567890
CHANNEL_ID=@your_channel_username

# Telegram user IDs allowed to operate the publisher.
# Multiple admins: 123456789,987654321
ADMIN_IDS=123456789

# Only needed for local webhook testing.
# Render automatically supplies RENDER_EXTERNAL_URL.
# PUBLIC_BASE_URL=https://example.ngrok-free.app
